{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/dist-vscode"
      ],
      "preLaunchTask": "build:vscode-host",
      "outFiles": ["${workspaceFolder}/dist-vscode/**/*.js"]
    }
  ]
}
